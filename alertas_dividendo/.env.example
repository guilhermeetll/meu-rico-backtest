# Copie para um arquivo só seu e exporte no crontab. Não commite o token.
ALERTAS_DATA_DIR=/var/lib/alertas_dividendo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Disclaimer "SIMULAÇÃO" em toda mensagem. 1 = ligado (padrão). 0 = desligado.
ALERTAS_SIMULACAO=1
# Quantos dias para trás a varredura da CVM olha a cada hora.
ALERTAS_LOOKBACK_DAYS=12
